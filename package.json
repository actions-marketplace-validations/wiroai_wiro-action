{
  "name": "wiro-action",
  "version": "1.1.0",
  "private": true,
  "description": "GitHub Action for Wiro AI: run image, video, audio, 3D and LLM models, or ask an LLM through the Wiro AI gateway.",
  "license": "MIT",
  "author": "Wiro AI",
  "homepage": "https://wiro.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiroai/Wiro-Action.git"
  },
  "bugs": {
    "url": "https://github.com/wiroai/Wiro-Action/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.js",
    "all": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/glob": "^0.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
